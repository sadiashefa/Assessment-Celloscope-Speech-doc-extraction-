# ============================================================
# Copy this file to .env and fill in values to activate real providers.
# The .env file is gitignored — never commit it.
# Without .env, docker compose up runs entirely on mock adapters.
# ============================================================

# --- Provider selection ---
# TRANSCRIPTION_PROVIDER options:
#   mock       → replays fixtures from disk, no credentials needed (default)
#   openrouter → OpenRouter + Gemini 2.5 Flash multimodal (recommended, uses OPENROUTER_API_KEY)
#   groq       → Groq Whisper API (get free key at console.groq.com, uses GROQ_API_KEY)
#   openai     → OpenAI Whisper API (uses OPENAI_API_KEY)
TRANSCRIPTION_PROVIDER=mock

# DOCUMENT_PROVIDER options:
#   mock       → replays fixtures from disk, no credentials needed (default)
#   openrouter → OpenRouter + Gemma 4 31B IT vision model (uses OPENROUTER_API_KEY)
DOCUMENT_PROVIDER=mock

# --- Secrets (leave blank in this file, fill in your .env) ---
# OPENROUTER_API_KEY is the only key needed when both providers are set to openrouter
OPENROUTER_API_KEY=
GROQ_API_KEY=       # only needed if TRANSCRIPTION_PROVIDER=groq
OPENAI_API_KEY=     # only needed if TRANSCRIPTION_PROVIDER=openai

# --- Model selection ---
# Model used for POST /api/v1/documents/extract (must support vision/image input)
OPENROUTER_MODEL=google/gemma-4-31b-it

# Model used for POST /api/v1/transcribe (must support audio input)
OPENROUTER_TRANSCRIPTION_MODEL=google/gemini-2.5-flash

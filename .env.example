# ============================================================
# Copy this file to .env and fill in values to activate real providers.
# The .env file is gitignored — never commit it.
# Without .env, docker compose up runs entirely on mock adapters.
# ============================================================

# PROVIDER options:
#   mock       -> replays fixtures from disk, no credentials needed (default)
#   openrouter -> calls OpenRouter APIs for both transcription and extraction
PROVIDER=mock

# Only needed when PROVIDER=openrouter
OPENROUTER_API_KEY=

# Model used for POST /api/v1/transcribe (must support audio input)
TRANSCRIPTION_PROVIDER_MODEL=google/gemini-2.5-flash

# Model used for POST /api/v1/documents/extract (must support image input)
DOCUMENT_EXTRACTION_PROVIDER_MODEL=google/gemini-2.5-flash
